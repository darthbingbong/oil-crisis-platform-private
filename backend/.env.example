# Copy this file to .env and fill in real values. Never commit the real .env.

# Required for the news classification pipeline (news/classifier.py).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Primary news source (news/ingestion.py). Free "Developer" tier, no card
# required: https://newsapi.org/register
# Without this set, ingestion runs in fixture-only mode (see
# news/fixtures.py and the POST /api/v1/news/test-inject endpoint) --
# nothing crashes, it just has no real articles to poll.
NEWSAPI_API_KEY=

# How often to poll NewsAPI, in seconds. Default (1200 = 20 min) keeps you
# at 72 calls/day, safely under the documented free-tier 100/day cap.
NEWS_POLL_INTERVAL_SECONDS=1200

# Route-news warm-up (fills the headline cache at startup, one route at a time). On by default; set to 0 to turn off (cold-start measurements, offline work).
NEWS_WARMUP=1

# Optional. AISStream.io key for the tanker feed (free, sign in with GitHub at https://aisstream.io). Server-side only; the browser never sees it.
# Without it the globe shows SIMULATED vessels. The adapter is UNVERIFIED against the live feed until someone runs it with a real key.
AISSTREAM_API_KEY=

# Optional. Free EIA Open Data key for the WTI / Brent price ticker (register at https://www.eia.gov/opendata/register.php).
# It stays on the server: the browser never sees it. Without it the ticker shows the last row of data/oil_daily_prices.csv, labelled OFFLINE_FALLBACK.
EIA_API_KEY=
